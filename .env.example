# MyStudioTV231 environment configuration
# Copy this file to .env and adjust the values.

# HTTP port used by the API server (dev: 4000, also used in vite dev proxy)
PORT=4000
NODE_ENV=development

# All development data lives under ./data (SQLite) and ./uploads (images).
# Override if you need another location:
# DATABASE_PATH=./data/mystudio.db
# UPLOADS_DIR=./uploads

# Public base URL used when building password-reset links.
PUBLIC_URL=http://localhost:5173

# Session / token lifetime
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_HOURS=1

# Optional SMTP. When left unset, password-reset links are printed in the
# server console instead of being emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM=MyStudioTV231 <no-reply@example.com>
# SMTP_SECURE=false