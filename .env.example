# MyStudioTV231 environment configuration
# Copy this file to .env and adjust the values.

# HTTP port used by the API server (dev: 4000, also used in vite dev proxy;
# Render provides this automatically via the $PORT env var)
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# Cross-origin cookie behavior. In production the frontend (Vercel) and API
# (Render) are different sites, so the session cookie must be SameSite=None.
# Set this explicitly if you ever need to override the automatic default.
# COOKIE_SAMESITE=none

# Comma-separated list of origins (no trailing slash) allowed to call this API
# with credentials. Never use "*" when cookies are involved. Defaults include
# the Vercel frontend and localhost dev origins; override to lock it down.
# CORS_ORIGINS=https://mystudiotv.vercel.app,http://localhost:5173

# All development data lives under ./data (SQLite) and ./uploads (images).
# Override if you need another location:
# DATABASE_PATH=./data/mystudio.db
# UPLOADS_DIR=./uploads

# Public base URL used when building password-reset links.
PUBLIC_URL=http://localhost:5173

# Session / token lifetime
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_HOURS=1

# Optional SMTP. When left unset, password-reset links are printed in the
# server console instead of being emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM=MyStudioTV231 <no-reply@example.com>
# SMTP_SECURE=false

# ---------------------------------------------------------------------------
# Frontend (Vite) environment. Prefix with VITE_ for Vite to expose it to the
# browser build. Contains a public URL only - never put secrets here.
# ---------------------------------------------------------------------------
# Base URL the browser build uses for API and uploaded-media requests.
# Defaults to http://localhost:4000 in dev and https://mystudiotv213.onrender.com
# in production. Only needed to override the built-in default.
# VITE_API_URL=http://localhost:4000
